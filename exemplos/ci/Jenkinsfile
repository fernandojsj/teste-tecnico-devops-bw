// Pipeline de referência para o bloco 4 (respostas/bloco-4-design-de-esteira.md)
// e o diagrama diagramas/esteira-cicd.drawio.
//
// Como funciona com Multibranch Pipeline: o Jenkins roda esse mesmo Jenkinsfile
// tanto quando uma PR é aberta contra a main (branch != main) quanto depois que
// a PR é mergeada (branch == main). Por isso os estágios de build/scan/push só
// rodam quando a branch é a main: numa PR, só testes + SonarQube + quality gate
// rodam, o que já bloqueia o merge se algo falhar. O merge em si não é um
// estágio daqui, é um evento do GitHub que dispara a próxima build na main.
//
// Esse job roda como Multibranch Pipeline de verdade: o Jenkins descobre cada
// branch do repositório (dev, main, etc.) e builda cada uma separadamente, com
// env.BRANCH_NAME correto, o que é o que faz "when { branch 'main' }" funcionar.
//
// Cada estágio também exige "changeset 'exemplos/app/**'" (pra não gastar
// build/scan/push por causa de uma mudança em resposta discursiva ou outro
// exemplo), com uma excecao: no primeiro build de uma branch nova nao existe
// build anterior pra comparar, entao "changeset" sempre da falso ali. Por isso
// o "currentBuild.number == 1" tambem libera o estagio nesse caso.
//
// A responsabilidade da CI termina no push pro ECR. Quem atualiza a tag da
// imagem no repositório de manifests é o time de DevOps, manualmente (ver
// bloco-4 e bloco-3), esse Jenkinsfile não escreve em nenhum outro repositório
// nem tem acesso ao cluster.

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        AWS_REGION         = 'us-east-1'
        AWS_ACCOUNT_ID     = credentials('aws-account-id')
        ECR_REPOSITORY     = 'teste-tecnico-bw-dev'
        APP_DIR            = 'exemplos/app'
        IMAGE_TAG          = "${env.GIT_COMMIT.take(7)}"
        SONAR_PROJECT_KEY  = 'teste-tecnico-bw-app'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Lint do Dockerfile') {
            when {
                anyOf {
                    expression { currentBuild.number == 1 }
                    changeset 'exemplos/app/**'
                }
            }
            steps {
                sh 'docker run --rm -i hadolint/hadolint hadolint --failure-threshold error - < $APP_DIR/Dockerfile'
            }
        }

        stage('Analise estatica (SonarQube)') {
            when {
                anyOf {
                    expression { currentBuild.number == 1 }
                    changeset 'exemplos/app/**'
                }
            }
            steps {
                withSonarQubeEnv('sonarqube-server') {
                    sh 'sonar-scanner -Dsonar.projectKey=$SONAR_PROJECT_KEY -Dsonar.sources=$APP_DIR'
                }
            }
        }

        stage('Quality Gate') {
            when {
                anyOf {
                    expression { currentBuild.number == 1 }
                    changeset 'exemplos/app/**'
                }
            }
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // A partir daqui, só roda depois que a PR foi mergeada na main.
        stage('Build da imagem') {
            when {
                allOf {
                    branch 'main'
                    anyOf {
                        expression { currentBuild.number == 1 }
                        changeset 'exemplos/app/**'
                    }
                }
            }
            steps {
                sh 'docker build --build-arg IMAGE_TAG=$IMAGE_TAG -t $ECR_REPOSITORY:$IMAGE_TAG $APP_DIR'
            }
        }

        stage('Scan de vulnerabilidades (Trivy)') {
            when {
                allOf {
                    branch 'main'
                    anyOf {
                        expression { currentBuild.number == 1 }
                        changeset 'exemplos/app/**'
                    }
                }
            }
            steps {
                sh 'docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy:latest image --exit-code 0 --severity HIGH,CRITICAL $ECR_REPOSITORY:$IMAGE_TAG'
            }
        }

        stage('Push para o ECR') {
            when {
                allOf {
                    branch 'main'
                    anyOf {
                        expression { currentBuild.number == 1 }
                        changeset 'exemplos/app/**'
                    }
                }
            }
            steps {
                sh '''
                    aws ecr get-login-password --region $AWS_REGION | docker login --username AWS --password-stdin $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com

                    docker tag $ECR_REPOSITORY:$IMAGE_TAG $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPOSITORY:$IMAGE_TAG
                    docker push $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPOSITORY:$IMAGE_TAG
                '''
            }
        }
    }

    post {
        success {
            echo "CI concluida, imagem publicada com a tag ${IMAGE_TAG}. Atualizacao do repositorio de manifests fica a cargo do DevOps."
        }
        failure {
            echo "Pipeline falhou, nenhuma imagem foi publicada no ECR."
        }
    }
}
